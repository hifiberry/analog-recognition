#!/bin/bash
set -e

case "$1" in
    configure)
        # Up to 0.3.0 this postinst wrote the WebUI descriptor and its icon into
        # /etc/hifiberry/players.d. The package also ships both under
        # /usr/share/hifiberry/players.d, and configurator lets /etc shadow
        # /usr/share -- so the copy written here masked the packaged one and
        # nothing ever read it.
        #
        # The two copies happen to be identical today, so nothing is visibly
        # broken. That is what makes it worth fixing now: the next field added
        # to the shipped descriptor would be masked silently, which is exactly
        # how hifiberry-librespot lost a conflicts_with declaration and
        # hifiberry-shairport lost its whole settings block.
        #
        # Remove the stale copy, but only when upgrading from an affected
        # version. On a fresh install a file here is an administrator's own
        # override, which is what /etc is for.
        if [ -n "$2" ] && dpkg --compare-versions "$2" lt 0.3.1; then
            rm -f /etc/hifiberry/players.d/analog.json
            rm -f /etc/hifiberry/players.d/icons/analog.svg
            echo "Removed the /etc descriptor that shadowed the packaged one."
        fi

        # Register systemd permissions via configserver drop-in
        mkdir -p /etc/configserver/conf.d
        cat > /etc/configserver/conf.d/analog-recognition.json <<'CONFEOF'
{
    "systemd": {
        "analog-recognition": "all"
    }
}
CONFEOF

        echo "Configserver drop-in installed for analog-recognition."

        # The ACR player definition (/etc/audiocontrol/players.d/analog.json)
        # now ships as a packaged conffile via debian/rules; it is no longer
        # generated here.
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
