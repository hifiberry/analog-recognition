#!/usr/bin/make -f

export CARGO_HOME = $(CURDIR)/debian/cargo_home
export CARGO_BUILD_JOBS = 1
export CARGO_INCREMENTAL = 0
export RUST_BACKTRACE = 0

%:
	dh $@

override_dh_auto_clean:
	dh_auto_clean
	rm -rf target/
	rm -rf $(CARGO_HOME)
	find . -name "*.rlib" -delete 2>/dev/null || true
	find . -name "*.rmeta" -delete 2>/dev/null || true

override_dh_auto_configure:
	if ! which cargo >/dev/null 2>&1; then \
		mkdir -p $(CARGO_HOME); \
		curl https://sh.rustup.rs -sSf | \
		CARGO_HOME=$(CARGO_HOME) \
		sh -s -- -y --no-modify-path; \
	fi

override_dh_auto_build:
	mkdir -p $(CURDIR)/build_workspace/tmp $(CURDIR)/build_workspace/home
	rm -rf $(CURDIR)/target/* 2>/dev/null || true
	export TMPDIR="$(CURDIR)/build_workspace/tmp" && \
	export HOME="$(CURDIR)/build_workspace/home" && \
	export PATH="$(CARGO_HOME)/bin:$$PATH" && \
	cargo build --release --jobs 1
	rm -rf $(CURDIR)/build_workspace

override_dh_auto_install:
	mkdir -p debian/hifiberry-analog-recognition/usr/bin
	cp target/release/analog-recognition debian/hifiberry-analog-recognition/usr/bin/
	strip debian/hifiberry-analog-recognition/usr/bin/analog-recognition

	mkdir -p debian/hifiberry-analog-recognition/usr/lib/systemd/user
	cp package-files/usr/lib/systemd/user/analog-recognition.service \
		debian/hifiberry-analog-recognition/usr/lib/systemd/user/

	mkdir -p debian/hifiberry-analog-recognition/etc/analog-recognition
	cp package-files/etc/analog-recognition/config.toml \
		debian/hifiberry-analog-recognition/etc/analog-recognition/

	mkdir -p debian/hifiberry-analog-recognition/usr/share/hifiberry-analog-recognition/icons
	cp package-files/usr/share/hifiberry-analog-recognition/icons/analog.svg \
		debian/hifiberry-analog-recognition/usr/share/hifiberry-analog-recognition/icons/

override_dh_auto_test:
	# Skip tests during packaging (run via `cargo test` in CI/dev instead)

override_dh_strip:
	dh_strip --no-automatic-dbgsym
	rm -rf $(CURDIR)/debian/hifiberry-analog-recognition/usr/lib/debug
