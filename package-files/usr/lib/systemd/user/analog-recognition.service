[Unit]
Description=HiFiBerry Analog Input Recognition
After=pipewire.service vu-meter.service
# After= only orders startup; it propagates nothing afterwards. songrec reaches
# PipeWire through pipewire-pulse, which survives a restart of the PipeWire
# daemon and reconnects -- but the capture stream does not come back, and
# songrec neither notices nor exits. Restart=on-failure never fires, because
# nothing failed. PartOf= makes a PipeWire restart restart this service too,
# which is the cheap half of the fix; the service also watches for a lost
# stream itself, for the cases systemd cannot see.
PartOf=pipewire.service

[Service]
Type=simple
# Only run on sound cards that expose an analog input (an ADC). --has-input
# exits 0 when the card has input channels and 1 otherwise (output-only and
# digital-only S/PDIF cards such as the Digi+ report input_channels=0), so
# this cleanly skips the service on those cards without marking it failed.
ExecCondition=/usr/bin/config-soundcard --has-input
ExecStartPre=/bin/sleep 2
ExecStart=/usr/bin/analog-recognition
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
