[Unit]
Description=HiFiBerry Analog Input Recognition
After=pipewire.service vu-meter.service

[Service]
Type=simple
# Only run on sound cards that expose an analog input (an ADC). The
# configurator reports input_channels=0 for output-only and digital-only
# (S/PDIF) cards such as the Digi+, so this cleanly skips the service there
# without marking it failed.
ExecCondition=/bin/sh -c 'ic=$(config-soundcard --input-channels 2>/dev/null); case "$ic" in ""|*[!0-9]*) exit 1;; esac; [ "$ic" -gt 0 ]'
ExecStartPre=/bin/sleep 2
ExecStart=/usr/bin/analog-recognition
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
